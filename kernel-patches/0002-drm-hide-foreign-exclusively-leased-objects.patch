drm: hide objects exclusively leased to another client

GETRESOURCES (crtc/encoder/connector), GETPLANERESOURCES: drop objects
held by a foreign exclusive lease from the listing.
GETCONNECTOR: force disconnected/empty state for a foreign exclusive
connector so no other compositor binds it (DP alt mode).
PAGE_FLIP: reject flips against a foreign exclusive crtc/plane (-EBUSY).

diff --git a/drivers/gpu/drm/drm_connector.c b/drivers/gpu/drm/drm_connector.c
index 994afa5..1069f9e 100644
--- a/drivers/gpu/drm/drm_connector.c
+++ b/drivers/gpu/drm/drm_connector.c
@@ -3171,6 +3171,23 @@ int drm_mode_getconnector(struct drm_device *dev, void *data,
 	if (!connector)
 		return -ENOENT;
 
+	/* Exclusively leased to another client: pretend nothing is plugged in
+	 * so no other compositor ever binds this connector (DP alt mode).
+	 */
+	if (drm_excl_obj_hidden_from(dev, connector->base.id, file_priv)) {
+		out_resp->connection = connector_status_disconnected;
+		out_resp->connector_type = DRM_MODE_CONNECTOR_Unknown;
+		out_resp->connector_type_id = 0;
+		out_resp->count_modes = 0;
+		out_resp->count_encoders = 0;
+		out_resp->encoder_id = 0;
+		out_resp->count_props = 0;
+		out_resp->mm_width = 0;
+		out_resp->mm_height = 0;
+		ret = 0;
+		goto out;
+	}
+
 	encoders_count = hweight32(connector->possible_encoders);
 
 	if ((out_resp->count_encoders >= encoders_count) && encoders_count) {
