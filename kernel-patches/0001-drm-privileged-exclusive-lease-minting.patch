+/**
+ * drm_excl_obj_hidden_from - object exclusively leased away from the caller
+ * @dev: DRM device
+ * @obj_id: mode object (CRTC/connector/encoder/plane) id
+ * @file_priv: caller's file
+ *
+ * Returns true when some lessee other than the caller's own master holds an
+ * exclusive (DRM_MODE_LEASE_EXCL) lease on @obj_id. Such objects must be
+ * invisible in resource listings, report as disconnected, and reject direct
+ * state programming from every other client.
+ */
+bool drm_excl_obj_hidden_from(struct drm_device *dev, u32 obj_id,
+			      struct drm_file *file_priv)
+{
+	struct drm_master *lessee, *caller_master;
+	bool hidden = false;
+
+	if (!obj_id)
+		return false;
+
+	caller_master = drm_file_get_master(file_priv);
+	if (!caller_master)
+		return false;
+
+	mutex_lock(&dev->mode_config.idr_mutex);
+	if (dev->master) {
+		drm_for_each_lessee(lessee, dev->master) {
+			if (lessee->exclusive && lessee != caller_master &&
+			    _drm_lease_held_master(lessee, obj_id)) {
+				hidden = true;
+				break;
+			}
+		}
+	}
+	mutex_unlock(&dev->mode_config.idr_mutex);
+	drm_master_put(&caller_master);
+
+	return hidden;
+}
