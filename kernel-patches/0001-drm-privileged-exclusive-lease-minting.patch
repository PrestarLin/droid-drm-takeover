+/**
+ * DRM_MODE_LEASE_EXCL - exclusive lease flag for DRM_IOCTL_MODE_CREATE_LEASE
+ *
+ * When set, the minted lessee becomes the sole visible/programmable owner of
+ * the leased objects from every other client's point of view: their resource
+ * listings hide the objects, connector state is forced to disconnected, and
+ * direct state programming on those objects fails with -EBUSY. Requires
+ * CAP_SYS_ADMIN (or being the current DRM master).
+ */
+#define DRM_MODE_LEASE_EXCL (1u << 30)
